# Python virtual environments
.venv/
.venv-gpu/
env/
venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Logs & runtime artifacts
*.log
.streamlit/

# Local Hugging Face cache
models/huggingface/

# Large model checkpoints (>100MB cannot be pushed to GitHub without Git LFS)
models/training/nllb_gov_domain/*.safetensors
models/training/**/checkpoint-*/

# Uploaded runtime user documents
data/uploads/*
!data/uploads/.gitkeep

# Environment variables & secrets
.env
.env.local
.DS_Store
Thumbs.db
